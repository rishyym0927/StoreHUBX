PORT=8080

MONGO_URI=mongodb://localhost:27017/storehub
MONGO_DB=storehub

JWT_SECRET=your-super-secret-jwt-key
TOKEN_ENC_KEY=your32charsecretkeyforstorehub12

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=storehub
S3_PUBLIC_BASE_URL=http://localhost:9000/storehub

BUILD_TMP_DIR=/tmp/storehub-builds
JOB_POLL_INTERVAL_MS=1000

REDIS_ADDR=localhost:6379

# Optional: front MinIO/S3 bundle URLs with a CDN (e.g. Cloudflare) instead
# of serving them directly. Leave unset to keep using S3_PUBLIC_BASE_URL.
# CDN_BASE_URL=https://cdn.example.com

# Optional: Groq fallback for GET /api/github/autofill (plan/repo-autofill.md).
# Only used when a repo has no description or fewer than 2 GitHub topics —
# deterministic GitHub data is preferred and used whenever it's available.
# AUTOFILL_AI_FALLBACK_ENABLED=true
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# --- Sandboxed builds -------------------------------------------------------
# Builds run inside a locked-down Docker container when the docker CLI and a
# reachable daemon are present. Set to false to force the legacy uncontained
# host build. When docker is simply absent, this degrades automatically.
# BUILD_SANDBOX_ENABLED=false

# Resource ceilings for each build container.
# BUILD_CONTAINER_MEMORY=1g
# BUILD_CONTAINER_CPUS=1.5

# Per-phase timeout (install and build are separate containers). Go duration
# syntax. Defaults to the same 5m the legacy host build uses.
# BUILD_CONTAINER_TIMEOUT=5m

# The install phase gets network (it needs a registry); the build phase runs
# with --network=none. Some projects legitimately fetch during build (webfonts,
# source-map upload) — enabling this retries a failed build phase once with
# network access on the isolated build bridge.
# BUILD_ALLOW_BUILD_NETWORK=true

# Optional: Groq fallback for build detection. Only consulted when no known
# framework signature matches, and only to fill in the framework label, which
# existing package.json script builds the project, and the output directory.
# Package manager, Node version and install command are always deterministic.
# Requires GROQ_API_KEY (shared with the autofill fallback above).
# BUILD_AI_FALLBACK_ENABLED=true
